# Optional override. The default is %USERPROFILE%\.prudence
PRUDENCE_DATA_DIRECTORY=

# Foundry profiles use Azure identity and do not store credentials.
FOUNDRY_PROJECT_ENDPOINT=https://example.services.ai.azure.com/api/projects/example
FOUNDRY_MODEL=gpt-4.1

# Local profiles can reference an environment variable by name in the GUI.
LOCAL_MODEL_API_KEY=
